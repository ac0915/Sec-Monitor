APP_NAME=SEC Monitor
APP_ENV=development
LOG_LEVEL=INFO

# Leave blank for local SQLite.
DATABASE_URL=

# SEC requires a real contact in User-Agent. Replace before production use.
SEC_USER_AGENT=SEC Monitor/2.0 your-email@example.com
POLL_INTERVAL_SECONDS=180
REQUEST_TIMEOUT_SECONDS=20
MAX_FEED_ENTRIES=100
MAX_DOCUMENT_CHARS=50000
FETCH_FULL_TEXT_FOR_ALL=true
ANALYZE_TIERS=1,2
TELEGRAM_TIERS=1,2
ANALYSIS_PROVIDER=gemini
ANALYSIS_MODEL=
ANALYSIS_TEMPERATURE=0.1
ANALYSIS_MAX_TOKENS=900
ANALYSIS_TIMEOUT_SECONDS=120
LLM_CHUNK_SIZE=1800
LLM_CHUNK_OVERLAP=250
ALLOWED_ORIGINS=*
DASHBOARD_RECENT_LIMIT=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# "copilot" provider uses the official Copilot SDK + Copilot CLI auth flow.
COPILOT_MODEL=gpt-4.1
COPILOT_NODE_BINARY=node
# Optional alternative to interactive CLI login:
# COPILOT_GITHUB_TOKEN=

# "github" provider uses GitHub Models' official inference API.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1
GITHUB_MODELS_BASE_URL=https://models.github.ai
GITHUB_MODELS_API_VERSION=2026-03-10
GITHUB_MODELS_ORG=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
